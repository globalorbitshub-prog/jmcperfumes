# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin auth ---
# Long random string used to sign session/challenge/2FA-setup JWTs.
# Generate with: openssl rand -base64 48
ADMIN_JWT_SECRET=
# Optional salt used when hashing IPs for audit logs / rate limiting.
IP_HASH_SALT=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Connect account ID of the perfume seller (destination for transfers).
STRIPE_CONNECT_ACCOUNT_ID=
# Platform commission percentage kept before transferring to the connected account.
STRIPE_COMMISSION_PERCENT=3

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM="JMC Perfumes <noreply@jmcperfumes.es>"

# --- Newsletter unsubscribe links ---
# Secret used to sign stateless unsubscribe tokens. Falls back to ADMIN_JWT_SECRET if unset.
UNSUBSCRIBE_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://jmcperfumes.es

# --- One-off admin bootstrap script (scripts/seed-admin.mjs) ---
# Not read by the Next.js app itself — only used when running `npm run seed:admin`.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME="Super Admin"
